  {
    "category": "PRIV",
    "changelog": [],
    "created_at": "2026-08-31T00:00:00Z",
    "description": "An app that targets Android 13 or later and reads the advertising ID must declare com.google.android.gms.permission.AD_ID. Without the permission the app receives a string of zeros, and the Play Console data safety form must still disclose the use.",
    "detection": {
      "mechanical_checks": [
        {
          "check_type": "api_usage",
          "parameters": {
            "include": [
              "**/*.kt",
              "**/*.java"
            ],
            "symbol": "\\bAdvertisingIdClient\\b"
          }
        }
      ],
      "targets": [
        "source"
      ]
    },
    "overridable": true,
    "platform": "android",
    "remediation": {
      "examples": [
        "<uses-permission android:name=\"com.google.android.gms.permission.AD_ID\" />"
      ],
      "summary": "Declare com.google.android.gms.permission.AD_ID in AndroidManifest.xml, and disclose the advertising ID in the Play Console data safety form."
    },
    "rule_id": "GPLAY-PRIV-001",
    "rule_type": "mechanical",
    "severity": "warning",
    "source": {
      "document": "google-play-advertising-id",
      "document_version": "2026-08-31",
      "section": "Advertising ID",
      "url": "https://support.google.com/googleplay/android-developer/answer/6048248"
    },
    "status": "validated",
    "title": "The advertising ID is read without the AD_ID permission",
    "updated_at": "2026-08-31T00:00:00Z",
    "version": 1
  },
