    "overridable": true,
    "platform": "ios",
    "remediation": {
      "examples": [
        "<key>NSCameraUsageDescription</key>\n<string>Peko uses the camera to scan a receipt so that you do not type it by hand.</string>"
      ],
      "forum_insights": [
        "Developers report that a string naming the concrete feature clears review, and that a string repeating the permission name does not."
      ],
      "summary": "Rewrite the purpose string to name the feature and the benefit to the user."
    },
    "rule_id": "AAPL-PERM-001",
