[
  {
    "category": "PERM",
    "changelog": [
      {
        "change": "Lowered the floor from 20 to 10 characters after the validation run of 2026-09-01. Bitwarden ships \"Scan QR codes\", which is 13 characters and names the feature. The floor still catches a bare \"Camera\".",
        "date": "2026-09-01T00:00:00Z"
      },
      {
        "date": "2026-09-02T02:13:48Z",
        "change": "Citation moved from 5.1.1(i) to 5.1.1. Apple writes that subsection inside the body of its parent rather than under its own heading, so the parent is where the text is."
      }
    ],
    "created_at": "2026-08-31T00:00:00Z",
    "description": "Every permission prompt needs a purpose string that explains what the app does with the data. App Review rejects a string that repeats the permission name or that says nothing specific. This check reports a purpose string shorter than 10 characters. It does not report a missing key, because an app that never asks for the permission does not need the string.",
    "detection": {
      "mechanical_checks": [
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
            "key": "NSCameraUsageDescription",
            "match": "non_empty_string",
            "min_length": 10,
            "required": false
          }
        },
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
            "key": "NSMicrophoneUsageDescription",
            "match": "non_empty_string",
            "min_length": 10,
            "required": false
          }
        },
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
            "key": "NSPhotoLibraryUsageDescription",
            "match": "non_empty_string",
            "min_length": 10,
            "required": false
          }
        },
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
            "key": "NSPhotoLibraryAddUsageDescription",
            "match": "non_empty_string",
            "min_length": 10,
            "required": false
          }
        },
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
            "key": "NSLocationWhenInUseUsageDescription",
            "match": "non_empty_string",
            "min_length": 10,
            "required": false
          }
        },
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
            "key": "NSLocationAlwaysAndWhenInUseUsageDescription",
            "match": "non_empty_string",
            "min_length": 10,
            "required": false
          }
        },
        {
          "check_type": "manifest_key_value",
          "parameters": {
            "file": "info_plist",
